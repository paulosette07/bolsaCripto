# =============================================================================
# Bolsa Monitor — modelo de variáveis de ambiente
# Copie para .env.local e preencha:  cp .env.local.example .env.local
# Nunca comite o .env.local (ele está no .gitignore).
# =============================================================================

# ----- Supabase (obrigatório) -------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# NUNCA prefixar com NEXT_PUBLIC_. Lida apenas no servidor (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# ----- Domínio dos e-mails (OPCIONAL) ----------------------------------------
# Os links de confirmação usam o host do próprio request (lib/config/site-url.ts),
# então isto só é necessário para forçar outro domínio.
# Em produção: https://bolsa-monitor.vercel.app
# Lembre de autorizar o domínio em Authentication → URL Configuration no Supabase.
NEXT_PUBLIC_SITE_URL=

# ----- Cotações ---------------------------------------------------------------
# Opcional. Brapi funciona sem token (rate limit menor). Token em brapi.dev/dashboard
BRAPI_TOKEN=
# Opcional. CoinGecko funciona sem chave (rate limit menor).
COINGECKO_API_KEY=

# ----- Cron / disparo de alertas ---------------------------------------------
# Header exigido: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ----- E-mail -----------------------------------------------------------------
# resend | smtp
EMAIL_PROVIDER=resend

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Sem domínio verificado, use onboarding@resend.dev (só entrega para o dono da conta)
RESEND_FROM=Bolsa Monitor <onboarding@resend.dev>

# SMTP (funciona com Gmail usando "senha de app")
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
