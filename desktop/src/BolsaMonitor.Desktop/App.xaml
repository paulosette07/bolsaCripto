<Application x:Class="BolsaMonitor.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:BolsaMonitor.Desktop.Converters"
             xmlns:vm="clr-namespace:BolsaMonitor.Desktop.ViewModels"
             xmlns:views="clr-namespace:BolsaMonitor.Desktop.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:CurrencyConverter x:Key="Currency" />
            <conv:PriceConverter x:Key="Price" />
            <conv:SignedCurrencyConverter x:Key="SignedCurrency" />
            <conv:PercentConverter x:Key="Percent" />
            <conv:NullablePercentConverter x:Key="NullablePercent" />
            <conv:ChangeBrushConverter x:Key="ChangeBrush" />
            <conv:ProfitBrushConverter x:Key="ProfitBrush" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisible" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisible" />
            <conv:NullToVisibilityConverter x:Key="NullToVisible" />
            <conv:CountToVisibilityConverter x:Key="CountToVisible" />
            <conv:InverseBoolConverter x:Key="InverseBool" />

            <!-- Cada página é resolvida pela ViewModel: a shell só troca o Content. -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:MarketViewModel}">
                <views:MarketView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:PortfolioViewModel}">
                <views:PortfolioView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AlertsViewModel}">
                <views:AlertsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
