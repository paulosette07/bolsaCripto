<UserControl x:Class="BolsaMonitor.Desktop.Views.MarketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:vm="clr-namespace:BolsaMonitor.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MarketViewModel}"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="RangeButton" TargetType="RadioButton">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource InkMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource UpBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource UpBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Busca -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid>
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource Field}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             VerticalContentAlignment="Center" />

                    <TextBlock Text="Busque por PETR4, VALE3, HGLG11 ou BTC…"
                               IsHitTestVisible="False"
                               Margin="13,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource InkFaintBrush}"
                               Visibility="{Binding SearchIsEmpty, Converter={StaticResource BoolToVisible}}" />
                </Grid>

                <Button Grid.Column="1"
                        Content="Buscar"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}"
                        Margin="8,0,0,0" />
            </Grid>

            <!-- Sugestões -->
            <Border Style="{StaticResource CardFlat}"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasSuggestions, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <TextBlock Text="Sugestões" Style="{StaticResource Caption}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.SelectAssetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Ticker}"
                                                   Width="86"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" />

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource InkMutedBrush}"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CryptoId}"
                                                   Style="{StaticResource Caption}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource DownSoftBrush}"
                    BorderBrush="#3A2020"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisible}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="{StaticResource InkBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Cotação -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding Ticker}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="{Binding AssetName}" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding AssetKind}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding PriceText}"
                                       Style="{StaticResource Numeric}"
                                       FontSize="28"
                                       HorizontalAlignment="Right" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <TextBlock Text="{Binding ChangePercent, Converter={StaticResource Percent}}"
                                           FontFamily="{StaticResource NumericFont}"
                                           FontSize="13"
                                           Foreground="{Binding ChangePercent, Converter={StaticResource ChangeBrush}}" />
                                <TextBlock Text="{Binding ChangeValueText}"
                                           FontFamily="{StaticResource NumericFont}"
                                           FontSize="13"
                                           Margin="8,0,0,0"
                                           Foreground="{StaticResource InkMutedBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding UpdatedAtText}"
                                       Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,16,0,12" />

                    <ItemsControl ItemsSource="{Binding Ranges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource RangeButton}"
                                             Content="{Binding Label}"
                                             GroupName="market-range"
                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                             Command="{Binding DataContext.SelectRangeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0"
                                Visibility="{Binding CanSwitchCurrency, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Moeda"
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />

                        <ItemsControl ItemsSource="{Binding Currencies}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource RangeButton}"
                                                 Content="{Binding Label}"
                                                 GroupName="market-currency"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.SelectCurrencyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <lvc:CartesianChart Series="{Binding ChartSeries}"
                                        XAxes="{Binding ChartXAxes}"
                                        YAxes="{Binding ChartYAxes}"
                                        Height="330"
                                        Background="Transparent"
                                        Margin="0,14,0,0"
                                        TooltipPosition="Hidden"
                                        LegendPosition="Hidden" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
