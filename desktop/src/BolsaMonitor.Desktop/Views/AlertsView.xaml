<UserControl x:Class="BolsaMonitor.Desktop.Views.AlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BolsaMonitor.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AlertsViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Verificar agora"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CheckNowCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Atualizar"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <!-- Aviso de e-mail não configurado -->
            <Border Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource LineStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding EmailWarning, Converter={StaticResource NullToVisible}}">
                <TextBlock Text="{Binding EmailWarning}"
                           FontSize="12"
                           Foreground="{StaticResource InkMutedBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Background="{StaticResource DownSoftBrush}"
                    BorderBrush="#3A2020"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisible}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="{StaticResource InkBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Border Background="{StaticResource UpSoftBrush}"
                    BorderBrush="{StaticResource UpBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding RunMessage, Converter={StaticResource NullToVisible}}">
                <TextBlock Text="{Binding RunMessage}"
                           FontSize="12"
                           Foreground="{StaticResource InkBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Lista -->
                <Border Style="{StaticResource Card}" Margin="0,0,7,0" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="18,16,18,10">
                            <TextBlock Text="Seus alertas" Style="{StaticResource SectionTitle}" />
                            <WrapPanel Margin="0,3,0,0">
                                <TextBlock Text="{Binding ActiveCount}" Style="{StaticResource Numeric}" FontSize="11" />
                                <TextBlock Text=" ativos · verificados pelo servidor a cada 5 minutos"
                                           Style="{StaticResource Caption}" />
                            </WrapPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />

                        <ItemsControl ItemsSource="{Binding Alerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Margin="18,12,18,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Ticker}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource InkBrush}"
                                                               VerticalAlignment="Center" />

                                                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ConditionLabel}"
                                                                   Style="{StaticResource Caption}"
                                                                   FontSize="10" />
                                                    </Border>

                                                    <Border Background="{StaticResource SurfaceAltBrush}"
                                                            CornerRadius="4"
                                                            Padding="6,1"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisible}}">
                                                        <TextBlock Text="PAUSADO"
                                                                   Style="{StaticResource Caption}"
                                                                   FontSize="9" />
                                                    </Border>
                                                </StackPanel>

                                                <WrapPanel Margin="0,4,0,0">
                                                    <TextBlock Text="Alvo " Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{Binding TargetText}"
                                                               FontFamily="{StaticResource NumericFont}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource InkBrush}" />
                                                    <TextBlock Text="  ·  atual " Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{Binding CurrentText}"
                                                               FontFamily="{StaticResource NumericFont}"
                                                               FontSize="12"
                                                               Foreground="{StaticResource InkMutedBrush}" />
                                                    <TextBlock Text="  ·  " Style="{StaticResource Caption}" />
                                                    <TextBlock Text="{Binding DistancePercent, Converter={StaticResource NullablePercent}}"
                                                               FontFamily="{StaticResource NumericFont}"
                                                               FontSize="12"
                                                               Foreground="{Binding DistancePercent, Converter={StaticResource ChangeBrush}}" />
                                                </WrapPanel>

                                                <TextBlock Text="{Binding LastNotifiedText}"
                                                           Style="{StaticResource Caption}"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Pausar"
                                                        Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.ToggleAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisible}}" />

                                                <Button Content="Ativar"
                                                        Style="{StaticResource GhostButton}"
                                                        Command="{Binding DataContext.ToggleAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisible}}" />

                                                <Button Content="×"
                                                        Style="{StaticResource GhostButton}"
                                                        FontSize="15"
                                                        Width="28"
                                                        Height="26"
                                                        Padding="0"
                                                        ToolTip="Remover alerta"
                                                        Command="{Binding DataContext.DeleteAlertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource Divider}" Margin="18,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Margin="18,14,18,18"
                                    Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVisible}}">
                            <TextBlock Text="Nenhum alerta ainda"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Defina um preço-alvo no formulário ao lado e receba um e-mail quando o ativo chegar lá."
                                       Style="{StaticResource PageSubtitle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Formulário -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Novo alerta" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Avisamos uma vez por cooldown enquanto a condição valer."
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,14" />

                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource LineStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,12"
                                Visibility="{Binding FormMessage, Converter={StaticResource NullToVisible}}">
                            <TextBlock Text="{Binding FormMessage}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource InkBrush}" />
                        </Border>

                        <TextBlock Text="Código do ativo" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding NewTicker, UpdateSourceTrigger=PropertyChanged}"
                                 CharacterCasing="Upper"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="Tipo" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource ComboField}"
                                  ItemsSource="{Binding AssetTypeOptions}"
                                  SelectedItem="{Binding SelectedAssetType}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="Condição" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource ComboField}"
                                  ItemsSource="{Binding ConditionOptions}"
                                  SelectedItem="{Binding SelectedCondition}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="Preço-alvo (R$)" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding NewTargetPrice, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="Intervalo entre avisos" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource ComboField}"
                                  ItemsSource="{Binding CooldownOptions}"
                                  SelectedItem="{Binding SelectedCooldown}"
                                  Margin="0,0,0,14" />

                        <Button Content="Criar alerta"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateAlertCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Histórico -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0">
                <StackPanel>
                    <StackPanel Margin="18,16,18,10">
                        <TextBlock Text="Histórico de disparos" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Prova de que o e-mail saiu — e com qual preço"
                                   Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" />

                    <ItemsControl ItemsSource="{Binding Events}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="18,9,18,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Ticker}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="{StaticResource InkMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="2"
                                            Background="{StaticResource SurfaceRaisedBrush}"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Style="{StaticResource Caption}"
                                                   FontSize="10" />
                                    </Border>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding CreatedAtText}"
                                               Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Nenhum alerta disparado até agora."
                               Style="{StaticResource PageSubtitle}"
                               Margin="18,10,18,18"
                               Visibility="{Binding HasEvents, Converter={StaticResource InverseBoolToVisible}}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
