<UserControl x:Class="BolsaMonitor.Desktop.Views.PortfolioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BolsaMonitor.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PortfolioViewModel}"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
        <StackPanel>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center" />
            </Grid>

            <Border Background="{StaticResource DownSoftBrush}"
                    BorderBrush="#3A2020"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10"
                    Margin="0,0,0,14"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisible}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12"
                           Foreground="{StaticResource InkBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- Resumo -->
            <UniformGrid Columns="4" Margin="0,0,0,14">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PATRIMÔNIO" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding TotalValueText}" Style="{StaticResource Numeric}" FontSize="19" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="CUSTO" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding TotalCostText}" Style="{StaticResource Numeric}" FontSize="19" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="RESULTADO" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding ProfitText}"
                                   Style="{StaticResource Numeric}"
                                   FontSize="19"
                                   Margin="0,6,0,0"
                                   Foreground="{Binding ProfitPercent, Converter={StaticResource ProfitBrush}}" />
                        <TextBlock Text="{Binding ProfitPercent, Converter={StaticResource NullablePercent}}"
                                   FontFamily="{StaticResource NumericFont}"
                                   FontSize="10"
                                   Foreground="{Binding ProfitPercent, Converter={StaticResource ProfitBrush}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="BOLSA / CRIPTO" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding AllocationText}" Style="{StaticResource Numeric}" FontSize="15" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Barra de alocação -->
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,14">
                <Grid Height="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding StockBarWidth}" />
                        <ColumnDefinition Width="{Binding CryptoBarWidth}" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource UpBrush}" CornerRadius="4,0,0,4" />
                    <Border Grid.Column="1" Background="#6366F1" CornerRadius="0,4,4,0" />
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tabela -->
                <Border Style="{StaticResource Card}" Margin="0,0,7,0" Padding="0">
                    <StackPanel>
                        <StackPanel Margin="18,16,18,10">
                            <TextBlock Text="Posições" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Ordenadas por valor de mercado"
                                       Style="{StaticResource Caption}"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />

                        <!-- Cabeçalho -->
                        <Grid Margin="18,8,18,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="94" />
                                <ColumnDefinition Width="94" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ATIVO" Style="{StaticResource TableHeaderText}" />
                            <TextBlock Grid.Column="1" Text="QTD." Style="{StaticResource TableHeaderText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="PREÇO" Style="{StaticResource TableHeaderText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="VALOR" Style="{StaticResource TableHeaderText}" TextAlignment="Right" />
                            <TextBlock Grid.Column="4" Text="DIA" Style="{StaticResource TableHeaderText}" TextAlignment="Right" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" />

                        <ItemsControl ItemsSource="{Binding Positions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Margin="18,10,18,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="94" />
                                                <ColumnDefinition Width="94" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="32" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Ticker}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource InkBrush}" />
                                                    <Border Background="{StaticResource SurfaceRaisedBrush}"
                                                            CornerRadius="3"
                                                            Padding="5,0"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AssetTypeLabel}"
                                                                   Style="{StaticResource Caption}"
                                                                   FontSize="9" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource Caption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="200"
                                                           HorizontalAlignment="Left" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Quantity}"
                                                       Style="{StaticResource Numeric}"
                                                       FontSize="11"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource InkMutedBrush}" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Price, Converter={StaticResource Price}}"
                                                       Style="{StaticResource Numeric}"
                                                       FontSize="11"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MarketValue, Converter={StaticResource Currency}}"
                                                           Style="{StaticResource Numeric}"
                                                           FontSize="11"
                                                           TextAlignment="Right" />
                                                <TextBlock Text="{Binding Profit, Converter={StaticResource SignedCurrency}}"
                                                           FontFamily="{StaticResource NumericFont}"
                                                           FontSize="10"
                                                           TextAlignment="Right"
                                                           Foreground="{Binding Profit, Converter={StaticResource ProfitBrush}}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="4"
                                                       Text="{Binding ChangePercent, Converter={StaticResource Percent}}"
                                                       FontFamily="{StaticResource NumericFont}"
                                                       FontSize="11"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding ChangePercent, Converter={StaticResource ChangeBrush}}" />

                                            <Button Grid.Column="5"
                                                    Content="×"
                                                    Style="{StaticResource GhostButton}"
                                                    FontSize="15"
                                                    Padding="0"
                                                    Width="26"
                                                    Height="26"
                                                    ToolTip="Remover ativo"
                                                    Command="{Binding DataContext.DeletePositionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>

                                        <Border Style="{StaticResource Divider}" Margin="18,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Nenhum ativo na carteira. Use o formulário ao lado para começar."
                                   Style="{StaticResource PageSubtitle}"
                                   Margin="18,10,18,18"
                                   Visibility="{Binding HasPositions, Converter={StaticResource InverseBoolToVisible}}" />
                    </StackPanel>
                </Border>

                <!-- Formulário -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Adicionar ativo" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Compra do mesmo ativo soma a quantidade e recalcula o preço médio."
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,14" />

                        <StackPanel Visibility="{Binding FormMessage, Converter={StaticResource NullToVisible}}">
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource LineStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10,8"
                                    Margin="0,0,0,12">
                                <TextBlock Text="{Binding FormMessage}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource InkBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="Código do ativo" Style="{StaticResource Label}" />
                        <TextBox x:Name="TickerBox"
                                 Style="{StaticResource Field}"
                                 Text="{Binding NewTicker, UpdateSourceTrigger=PropertyChanged}"
                                 CharacterCasing="Upper"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="Tipo" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource ComboField}"
                                  ItemsSource="{Binding AssetTypeOptions}"
                                  SelectedItem="{Binding SelectedAssetType}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="Quantidade" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,4" />
                        <TextBlock Text="{Binding QuantityHint}" Style="{StaticResource Caption}" Margin="0,0,0,12" />

                        <TextBlock Text="Preço médio (opcional)" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding NewAvgPrice, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="Observação (opcional)" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource Field}"
                                 Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,14" />

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Content="Adicionar à carteira"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddPositionCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                            <Button Grid.Column="1"
                                    Content="Limpar"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding ClearFormCommand}"
                                    Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
