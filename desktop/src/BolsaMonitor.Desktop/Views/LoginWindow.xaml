<Window x:Class="BolsaMonitor.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BolsaMonitor.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:LoginViewModel}"
        Title="Bolsa Monitor — Entrar"
        Width="960"
        Height="620"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Painel de marca -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="36,32,36,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource UpBrush}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="3" Height="9" CornerRadius="1.5" Background="{StaticResource UpDeepBrush}" Margin="1.5,6,0,0" />
                            <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource UpDeepBrush}" Margin="1.5,0,0,0" />
                            <Border Width="3" Height="18" CornerRadius="1.5" Background="#8C04140E" Margin="1.5,0,1.5,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Bolsa Monitor" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Text="B3 e cripto em um só lugar" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Seu mercado inteiro," FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="em uma tela só." FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource UpBrush}" />

                    <TextBlock Text="Monitore a B3 e as criptomoedas que você acompanha, controle sua carteira e não perca mais um ponto de entrada."
                               Style="{StaticResource PageSubtitle}"
                               Margin="0,14,0,0" />

                    <StackPanel Margin="0,26,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource UpBrush}" VerticalAlignment="Top" Margin="0,6,10,0" />
                            <StackPanel>
                                <TextBlock Text="Cotações em tempo real" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Ações, FIIs e cripto com gráfico e variação do dia." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource UpBrush}" VerticalAlignment="Top" Margin="0,6,10,0" />
                            <StackPanel>
                                <TextBlock Text="Carteira consolidada" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Quantidade exata de cada ativo e patrimônio total." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{StaticResource UpBrush}" VerticalAlignment="Top" Margin="0,6,10,0" />
                            <StackPanel>
                                <TextBlock Text="Alertas por e-mail" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="Defina preço-alvo e receba aviso automático." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="Dados de mercado por Brapi e CoinGecko. Este app não faz recomendação de investimento."
                           Style="{StaticResource Caption}"
                           TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- Formulário -->
        <Grid Grid.Column="1" Margin="48,32,48,32">
            <StackPanel VerticalAlignment="Center" MaxWidth="380">

                <TextBlock Text="Entrar na conta" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="Acompanhe sua carteira e seus alertas de preço."
                           Style="{StaticResource PageSubtitle}"
                           Margin="0,6,0,0" />

                <!-- Configuração ausente -->
                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource LineStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,18,0,0"
                        Visibility="{Binding IsConfigurationMissing, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{Binding ConfigurationHint}"
                               FontSize="12"
                               Foreground="{StaticResource InkMutedBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Erro -->
                <Border Background="{StaticResource DownSoftBrush}"
                        BorderBrush="#3A2020"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,10"
                        Margin="0,18,0,0"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisible}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12"
                               Foreground="{StaticResource InkBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="E-mail" Style="{StaticResource Label}" Margin="0,20,0,6" />
                <TextBox Style="{StaticResource Field}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Height="40"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="Senha" Style="{StaticResource Label}" Margin="0,14,0,6" />
                <PasswordBox x:Name="PasswordInput"
                             Style="{StaticResource PasswordField}"
                             Height="40"
                             PasswordChanged="OnPasswordChanged" />

                <Button Content="Entrar"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SignInCommand}"
                        IsEnabled="{Binding CanSubmit}"
                        Height="42"
                        Margin="0,22,0,0" />

                <TextBlock Text="Ainda não tem conta? Crie a sua no site do Bolsa Monitor e confirme o e-mail antes de entrar aqui."
                           Style="{StaticResource Caption}"
                           TextWrapping="Wrap"
                           Margin="0,18,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
