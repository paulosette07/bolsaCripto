<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BolsaMonitor.Core\BolsaMonitor.Core.csproj" />
  </ItemGroup>

  <!--
    appsettings.json fica fora do controle de versão (contém chaves).
    Quando existir, é copiado para a saída do build; appsettings.example.json
    fica no repositório como modelo.
  -->
  <ItemGroup>
    <None Include="appsettings.json" Condition="Exists('appsettings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Identidade do executável distribuído na release do GitHub. -->
    <AssemblyName>BolsaMonitor</AssemblyName>
    <RootNamespace>BolsaMonitor.Desktop</RootNamespace>
    <Product>Bolsa Monitor</Product>
    <Company>Bolsa Monitor</Company>
    <Description>Monitor de cotações da B3 e criptomoedas, com carteira e alertas.</Description>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
